# 复制为 .env 后按本机情况修改；不要把真实密码提交到仓库。
# 本项目读取进程环境变量，不自动加载 .env 文件，启动前请先导入变量。

# ---- MySQL（阶段 01 交接的参数名）----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=futures_reports
DB_USER=futures_app
DB_PASSWORD=
DB_CONNECT_TIMEOUT=10

# ---- 资料目录与版本 ----
DATA_ROOT=data
ANALYZER_VERSION=backend-1.0.0
PARSER_TIMEOUT_SECONDS=60

# ---- 附件读取上限 ----
MAX_ATTACHMENT_DEPTH=2
MAX_ATTACHMENTS=8

# ---- 批处理 ----
ANALYZE_WORKERS=1

# ---- 模型兜底（阶段 05 交接）----
LLM_ENABLED=true
LLM_ENDPOINT=
LLM_API_TOKEN=
LLM_MODEL_ID=course-fallback
LLM_PROMPT_VERSION=fallback-v1
LLM_CONNECT_TIMEOUT=10
LLM_READ_TIMEOUT=60
LLM_MAX_RESPONSE_BYTES=262144
LLM_MAX_FRAGMENTS=3

# ---- FastAPI ----
API_PAGE_SIZE=50
API_MAX_PAGE_SIZE=100
API_CORS_ORIGINS=
